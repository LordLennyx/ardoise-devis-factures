    {"t": "click", "sel": "#tpl [data-t=marge]", "pause": 1000},
    {"t": "click", "sel": "#convert", "pause": 1400},
    {"t": "eval", "js": "const s=document.querySelector('[data-b=statut]');s.value='paye';s.dispatchEvent(new Event('input',{bubbles:true}))", "pause": 1400},
